{
  "Name": "Add Extra Properties",
  "Description": "Adds custom key/value extra properties to a JSM Ops alert (for example entity IDs, rule names, or environment).",
  "Integration": "JSM Ops",
  "IsCustom": true,
  "IsEnabled": true,
  "Type": 0,
  "Parameters": [
    {
      "Name": "Alert ID",
      "Type": 0,
      "Description": "ID of the alert to enrich with extra properties.",
      "IsMandatory": true,
      "Value": ""
    },
    {
      "Name": "Extra Properties",
      "Type": 0,
      "Description": "JSON object string of extra properties (for example: {\"host\":\"server1\",\"rule\":\"suspicious_login\"}).",
      "IsMandatory": true,
      "Value": ""
    }
  ],
  "ScriptResultName": "is_success",
  "SimulationDataJson": "{\"entities\": []}",
  "HasJsonResult": true,
  "DynamicResultsMetadata": [
    {
      "ResultName": "JsonResult",
      "ShowResult": true,
      "ResultExample": "{\n  \"result\": \"Request will be processed\",\n  \"requestId\": \"e5f6a7b8-c9d0-1234-ef01-345678901234\",\n  \"took\": 0.154\n}"
    }
  ]
}
