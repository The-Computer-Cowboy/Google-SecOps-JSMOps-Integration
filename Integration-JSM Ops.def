  "IntegrationSupportedActions": [
    {
      "Name": "Ping",
      "Description": "Verifies connectivity and credentials for the JSM Ops integration. Disabled by default and not intended for playbook use."
    },
    {
      "Name": "Close Alert",
      "Description": "Closing an alert indicates that the issue has been resolved and no further action is necessary."
    },
    {
      "Name": "Create Alert",
      "Description": "Creates a JSM Ops alert for your team. Optional Alias supports SecOps deduplication; Source, Details, and comma-separated tags add investigation context."
    },
    {
      "Name": "Get Request Status",
      "Description": "Tracks the status of asynchronous JSM Ops write requests (Create, Close, Escalate, Acknowledge, Assign, and similar actions) and returns alert details when available. Use the Request ID returned by those actions."
    },
    {
      "Name": "Escalate Alert",
      "Description": "Escalation triggers the defined escalation policies which could involve notifying additional users or teams, or increasing the frequency of notifications for the alert."
    },
    {
      "Name": "Acknowledge Alert",
      "Description": "Acknowledges a JSM Ops alert to indicate it is being handled and to stop further escalation notifications."
    },
    {
      "Name": "Add Alert Note",
      "Description": "Adds a note to a JSM Ops alert for investigation updates, case links, or enrichment context."
    },
    {
      "Name": "Get Alert",
      "Description": "Retrieves full details for a JSM Ops alert by Alert ID, including status, priority, owner, tags, and responders."
    },
    {
      "Name": "List Alerts",
      "Description": "Lists JSM Ops alerts with optional query filtering and pagination. Use to check for existing open alerts before creating a new one."
    },
    {
      "Name": "Get Alert by Alias",
      "Description": "Retrieves a JSM Ops alert using its alias. Useful for correlating SecOps case or alert IDs used as the alias on create."
    },
    {
      "Name": "Get On-Call",
      "Description": "Lists current on-call responders for a JSM Ops schedule. Optionally evaluate on-call at a specific date/time."
    },
    {
      "Name": "Assign Alert",
      "Description": "Assigns a JSM Ops alert to a specific user by Atlassian account ID."
    },
    {
      "Name": "Add Responder",
      "Description": "Adds a responder (team, user, escalation, or schedule) to a JSM Ops alert."
    },
    {
      "Name": "Update Priority",
      "Description": "Updates the priority of an existing JSM Ops alert (P0-P5)."
    },
    {
      "Name": "Add Tags",
      "Description": "Adds one or more tags to a JSM Ops alert for routing, categorization, or reporting."
    },
    {
      "Name": "Add Extra Properties",
      "Description": "Adds custom key/value extra properties to a JSM Ops alert (for example entity IDs, rule names, or environment)."
    }
  ],
